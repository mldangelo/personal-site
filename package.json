{
  "name": "personal-site",
  "version": "4.1.0",
  "homepage": "https://mldangelo.com/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mldangelo/personal-site.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "lint": "biome check .",
    "type-check": "tsc --noEmit",
    "format": "biome format --write . && prettier --write \"**/*.{md,css}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true npm run build",
    "og": "node scripts/generate-og.mjs",
    "og:check": "npm run og:check:ledger && npm run og:check:render",
    "og:check:ledger": "node scripts/check-og.mjs",
    "og:check:render": "node scripts/generate-og.mjs --check",
    "icons": "node scripts/generate-icons.mjs",
    "verify-export": "node scripts/verify-export.mjs",
    "measure-export": "node scripts/measure-export.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@next/third-parties": "^16.4.5",
    "@tailwindcss/postcss": "^4.3.4",
    "js-yaml": "^5.5.0",
    "markdown-to-jsx": "^9.10.5",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@next/bundle-analyzer": "^16.4.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "nanoid": "^3.3.20",
    "source-map-js": "^1.2.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
